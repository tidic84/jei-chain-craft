{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/tidic84/jei-chain-craft",
        "issues": "https://github.com/tidic84/jei-chain-craft/issues"
    },
    "license": "${license}",
    "environment": "client",
    "accessWidener": "${mod_id}.accesswidener",
    "entrypoints": {
        "client": [
            "fr.tidic.jeichaincraft.fabric.JEIChainCraftFabric"
        ],
        "jei_mod_plugin": [
            "fr.tidic.jeichaincraft.jei.JEIChainCraftPlugin"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}",
        "jei": ">=19.0.0"
    }
}
